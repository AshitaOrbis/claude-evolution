# Claude Evolution Configuration
# Copy to .env and customize.
#
# SECURITY: .env is sourced as shell code by the heartbeat scripts -- anything
# in it executes with your privileges. Keep it user-owned with mode 600 (the
# scripts refuse to load it otherwise), use only KEY=value lines, and never
# let automation write to it. See SECURITY.md.

# Path to this repository (auto-detected from scripts, but can override)
# EVOLUTION_DIR=/path/to/claude-evolution

# Claude model for discovery phase (default: sonnet)
DISCOVERY_MODEL=sonnet

# Claude model for evaluation/integration (default: sonnet)
EVAL_MODEL=sonnet

# Optional: Discord webhook URL for notifications.
# NOTE: enabling this sends the first lines of each daily report to Discord
# (a third party). Credential-shaped strings are redacted best-effort only.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Optional: fully autonomous integration (default: 0 = review-gated).
# 1 = agents get Bash and approved items are written directly into your live
# Claude Code config. Read SECURITY.md before enabling.
EVOLUTION_AUTONOMOUS=0
